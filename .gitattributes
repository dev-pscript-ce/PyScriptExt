# Large files: Git LFS
*.exe filter=lfs diff=lfs merge=lfs -text
*.pkg filter=lfs diff=lfs merge=lfs -text
*.vsix filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
# Text files: normalize to LF in Git
* text=auto
# Python and JavaScript source
*.py   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
# Configuration and documentation
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
# Windows scripts
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
# Binary files
*.dll  binary
*.pyd  binary
