func Clear_RunHistory() {
    key = '"HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\RunMRU"'
    r_item = "Remove-Item "
    force = " \-Recurse \-Force"
    Set_Interval 0.02
    Hot_Key ("win", "r")
    Write ("pwsh")
    Press("enter")
    Write (r_item)
    Write (key)
    Write (force)
    Press("enter")
}


func open_pwsh (){
    Hot_Key ("win", "r")
    Write ("pwsh")
}
func enter(){
    Press "enter"
}
func cls (){
