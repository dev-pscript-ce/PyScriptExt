func positive_negative_number ():
    a = 6
    msg = a % 2 == 0 ? "Số dương" : "Số âm"
    printl("${msg}","C") 


func walrus (){
    printl("walrus:=",x:=20,"Y")
} 

func add_multi(a, b,isadd = true) {

    multi = (a,b,*args) => a * b
    
    if isadd:
        return a + b
    else:
        kq = multi(a,b,isadd)
        return kq
}

