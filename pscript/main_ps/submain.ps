func if_else_loop():
    
    x = 1

    if x==1 {
        Set_Interval( 0.2)
        Hot_Key ("win","r")
        Write ("notepad")
        Press ("enter")
        Write "abcdefghiklmn"
    }
    elif x==3 {
        Set_Interval 0.2
        Hot_Key "win","r"
        Write ("notepad")
        Press ("enter")
        Write "nghrdttu" 
    }
    else {
        Set_Interval 0.2
        Hot_Key ("win","r")
        Write ("notepad")
        Press ("enter")
        Write "ABCDEF"
    }

func while_loop(a=0){
    while a < 10 {
        a = a+1   
        printl(a,"C")    
    }
} 


