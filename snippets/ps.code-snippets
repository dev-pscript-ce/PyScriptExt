{
  "Function{": {
    "prefix": "func(){",
    "body": ["func ${1:functionName}(${2:args}){\n\t${3}", "}${0}"],
    "description": "Create a function",
  },
  "Function:": {
    "prefix": "func():",
    "body": ["func ${1:functionName}(${2:args}):\n\t${3}", "${0}"],
    "description": "Create a function",
  },

  "Class(){": {
    "prefix": "class(){",
    "body": ["class ${1:ClassName}(${2:args}) {", "\t${4}", "}${0}"],
    "description": "Create a PyJs class",
  },
  "Class():": {
    "prefix": "class():",
    "body": ["class ${1:ClassName}(${2:args}):\n\t${3}", "${0}"],
    "description": "Create a function",
  },
  "Class:": {
    "prefix": "class:",
    "body": ["class ${1:ClassName}:\n\t${3}", "${0}"],
    "description": "Create a class",
  },
  "Class{": {
    "prefix": "class{",
    "body": ["class ${1:ClassName}:\n\t${3}", "${0}"],
    "description": "Create a class",
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "\t${0}"],
    "description": "Create an if statement",
  },
  "If Else": {
    "prefix": "ife",
    "body": ["if ${1:condition}:", " ${2}", "else", " ${0}"],
    "description": "Create an if-else statement",
  },
  "If Else If": {
    "prefix": "ifel",
    "body": [
      "if ${1:condition}:",
      " ${2}",
      "elif ${3:condition}:",
      " ${4}",
      "else:",
      " ${0}",
    ],
    "description": "Create an if-elif-else statement",
  },
  "While": {
    "prefix": "while",
    "body": ["while ${1:condition}", " ${0}"],
    "description": "Create a while loop",
  },
  "For": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items}", " ${0}"],
    "description": "Create a for loop",
  },
  "Import": {
    "prefix": "import",
    "body": ["import ${0:module}"],
    "description": "Import a module",
  },
  "Import As": {
    "prefix": "impas",
    "body": ["import ${1:module} as ${0:alias}"],
    "description": "Import a module with an alias",
  },
  
  "print": {
